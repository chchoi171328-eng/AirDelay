# ─── EmailJS (필수 — 사건 접수 메일 발송) ─────────────────
# 메일은 서버에서만, 법인 수신용 한 통만 보냅니다 (고객 확인 메일 없음 → 접수 1건 = 요청 1회).
# EmailJS 대시보드 Account > Security 에서
#   1) "Allow EmailJS API for non-browser applications" 켜기
#   2) "Use Private Key" 켜기 (공개 키만으로 메일을 보낼 수 없게 막음)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_FIRM_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# ─── Supabase (선택 — 나중에 DB를 붙일 때) ─────────────────
# 세 값을 모두 넣으면 접수 내용이 메일과 함께 DB에도 저장됩니다 (첨부파일은 받지 않습니다).
# 먼저 supabase/migrations 의 SQL을 실행하고, 개인정보처리방침(src/app/privacy/page.tsx)에 Supabase를 추가하세요.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용 키 — 절대 NEXT_PUBLIC_ 을 붙이지 마세요.
SUPABASE_SERVICE_ROLE_KEY=
