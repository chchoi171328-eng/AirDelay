# ─── Supabase ─────────────────────────────────────────────
# 사례·블로그 조회와 첨부파일 업로드 주소에 사용 (공개돼도 되는 값)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 사건 접수 저장용 서버 전용 키 — 절대 NEXT_PUBLIC_ 을 붙이지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# ─── EmailJS (서버에서 발송) ──────────────────────────────
# EmailJS 대시보드 Account > Security 에서
#   1) "Allow EmailJS API for non-browser applications" 켜기
#   2) "Use Private Key" 켜기 (공개 키만으로 메일을 보낼 수 없게 막음)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_FIRM_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_CLIENT_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
